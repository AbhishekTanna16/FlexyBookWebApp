   @page "/locations"
   @using FlexybookWebApp.Models
   @using FlexybookWebApp.Services
   @inject ILocationService LocationService

<PageTitle>Locations</PageTitle>

<h1>Our Locations</h1>

@if (locations == null)
{
    <p>Loading...</p>
}
else
{
    <div class="location-grid">
        @foreach (var location in locations)
        {
            <div class="location-card">
                <h2>@location.Name</h2>
                <p>@location.Address</p>
                <div class="status @(location.IsOpen ? "open" : "closed")">
                    @(location.IsOpen ? "Open" : "Closed")
                </div>
                <a href="/location/@location.Id" class="view-details">View Details</a>
            </div>
        }
    </div>
}

@code {
    private LocationModel[]? locations;

    protected override async Task OnInitializedAsync()
    {
        locations = await LocationService.GetLocationsAsync();
    }
   }
